{
  "name": "obsidian-live-git-diff",
  "version": "0.4.0",
  "description": "Compare and edit notes in native Live Preview against a pinned Git version. Changes only the presentation; never writes note content.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "author": "Jessica Kosturko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkosturko/obsidian-live-git-diff.git"
  },
  "bugs": {
    "url": "https://github.com/jkosturko/obsidian-live-git-diff/issues"
  },
  "homepage": "https://github.com/jkosturko/obsidian-live-git-diff#readme",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production && npm run gate",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "gate": "node tools/check-invariant.mjs",
    "test": "node --test \"test/**/*.test.ts\"",
    "capture-oracle": "node tools/capture-sections.mjs",
    "ci": "npm run build && npm test"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "obsidian-md",
    "git",
    "diff",
    "review",
    "markdown"
  ],
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "diff": "9.0.0",
    "markdown-it": "15.0.3"
  }
}
