root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses trailing double-spaces as a hard line break.
trim_trailing_whitespace = false

[test/fixtures/*.md]
# Fixture bytes are the test input, and the grain oracle pins their sha256.
# Reformatting them on save invalidates the oracle.
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab
